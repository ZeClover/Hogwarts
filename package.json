{
  "name": "hogwarts-1890-arquivos-magicos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "build": "tsc && node scripts/check-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src public/*.js tests scripts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts migrate",
    "master:invite": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts master-invite",
    "backup": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts backup"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
